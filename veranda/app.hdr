# Lighthouse Pinball (tools/vpack.py): the program; records 1-3 the
# table's picture, 4 its colours, 5-6 the sprites (banked: read in place).
# The file is "Lighthouse Pinball.cvt" (a long name, Veranda's API 5); the
# GEOS name is its first 16 characters, as the kernel keeps them (kAppName:
# the dock matches a pin to a program put aside by them). The class stays.
name        = Lighthouse Pinba
class       = Lighthouse
version     = 1.0
author      = Marcin Spoczynski
description = Lighthouse Pinball: a night harbour table with fog banks, a ferry ramp and a jackpot.
mode        = 640x480
api         = 4
overlays    = banked
icon        = icon.pbm
tile        = tile.txt
